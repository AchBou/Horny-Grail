{
  "name": "hornygrail-mobile-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:private-config": "node ./scripts/prepare-private-config.mjs",
    "predev": "npm run prepare:private-config",
    "dev": "vite dev --host",
    "prebuild": "npm run prepare:private-config",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview --host",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --threshold error",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open:android": "node ./scripts/open-android-studio.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/cli": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@sveltejs/adapter-static": "3.0.11",
    "@sveltejs/kit": "2.70.4",
    "svelte": "5.59.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.0",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "8.3.8"
  }
}
