{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "**/*.jpg" }, { "path": "**/*.jpeg" }, { "path": "**/*.png" },
        { "path": "**/*.gif" }, { "path": "**/*.webp" }, { "path": "**/*.bmp" },
        { "path": "**/*.tif" }, { "path": "**/*.tiff" }, { "path": "**/*.webm" },
        { "path": "**/*.mp4" },
        { "path": "**/*.JPG" }, { "path": "**/*.JPEG" }, { "path": "**/*.PNG" },
        { "path": "**/*.GIF" }, { "path": "**/*.WEBP" }, { "path": "**/*.BMP" },
        { "path": "**/*.TIF" }, { "path": "**/*.TIFF" }, { "path": "**/*.WEBM" },
        { "path": "**/*.MP4" }
      ]
    },
    "fs:default",
    "fs:allow-read",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [{ "path": "**" }]
    },
    "fs:allow-write",
    "fs:allow-watch",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://**" },
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" }
      ]
    },
    "dialog:default"
  ]
}
