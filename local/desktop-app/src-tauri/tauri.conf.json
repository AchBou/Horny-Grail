{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Horny Grail",
  "version": "0.1.0",
  "identifier": "com.hornygrail.app",
  "build": {
    "beforeDevCommand": "npm run ffmpeg:ensure && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run ffmpeg:ensure && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "The Horny Grail",
        "width": 960,
        "height": 900,
        "minWidth": 640,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost blob: data: https://*.amazonaws.com",
        "media-src": "'self' asset: http://asset.localhost blob: https://*.amazonaws.com",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost blob: data: https://*.amazonaws.com",
        "media-src": "'self' asset: http://asset.localhost blob: https://*.amazonaws.com",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "binaries/ffmpeg.exe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
