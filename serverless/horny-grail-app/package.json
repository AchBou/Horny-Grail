{
    "name": "horny-grail-backend",
    "description": "HornyGrail backend: SAM app with auth, read and write Lambdas",
    "version": "0.0.1",
    "private": true,
    "dependencies": {
        "@aws-sdk/client-dynamodb": "^3.1177.0",
        "@aws-sdk/client-s3": "^3.1177.0",
        "@aws-sdk/client-secrets-manager": "^3.1177.0",
        "@aws-sdk/lib-dynamodb": "^3.1177.0",
        "@aws-sdk/s3-request-presigner": "^3.1177.0"
    },
    "devDependencies": {
        "@aws-sdk/client-cloudformation": "^3.1177.0",
        "@aws-sdk/client-lambda": "^3.1177.0",
        "aws-sdk-client-mock": "^4.1.0",
        "esbuild": "0.28.2",
        "jest": "^29.7.0"
    },
    "scripts": {
        "cloudfront:sync": "node ./scripts/sync-cloudfront-functions.mjs",
        "set-access-code": "node ./scripts/set-access-code.mjs",
        "check-access-code": "node ./scripts/set-access-code.mjs --check",
        "unlock-logins": "node ./scripts/unlock-logins.mjs",
        "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
        "sam:dev": "npm run cloudfront:sync && npm run build && sam local start-api",
        "sam:deploy": "npm run cloudfront:sync && npm run build && sam deploy",
        "sam:sync": "sam sync --stack-name horny-grail-app --code --dependency-layer",
        "build": "sam build",
        "deploy:changeset": "sam build && sam deploy --no-execute-changeset --no-confirm-changeset"
    },
    "jest": {
        "testMatch": [
            "**/__tests__/**/*.[jt]s?(x)",
            "**/?(*.)+(spec|test).[jt]s?(x)",
            "**/__tests__/**/*.mjs?(x)",
            "**/?(*.)+(spec|test).mjs?(x)"
        ],
        "testPathIgnorePatterns": [
            "/node_modules/",
            "/.aws-sam/"
        ],
        "setupFiles": [
            "<rootDir>/jest.setup.mjs"
        ],
        "moduleFileExtensions": [
            "mjs",
            "js"
        ]
    }
}
